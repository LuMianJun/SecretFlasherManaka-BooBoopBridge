<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SecretFlasherManaka.BooBoopBridge</AssemblyName>
    <RootNamespace>SecretFlasherManaka.BooBoopBridge</RootNamespace>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <GameDir Condition="'$(GameDir)' == ''">$(BOOBOOP_GAME_DIR)</GameDir>
    <CoreDir>$(GameDir)/BepInEx/core</CoreDir>
    <InteropDir>$(GameDir)/BepInEx/interop</InteropDir>
    <GameSignalsProject Condition="'$(GameSignalsProject)' == '' and Exists('$(MSBuildThisFileDirectory)dependencies/SecretFlasherManaka-ForEveryThing/SecretFlasherManaka.ForEveryThing.csproj')">$(MSBuildThisFileDirectory)dependencies/SecretFlasherManaka-ForEveryThing/SecretFlasherManaka.ForEveryThing.csproj</GameSignalsProject>
    <GameSignalsProject Condition="'$(GameSignalsProject)' == ''">$(MSBuildThisFileDirectory)../SecretFlasherManaka-ForEveryThing/SecretFlasherManaka.ForEveryThing.csproj</GameSignalsProject>
    <HardwareControlProject Condition="'$(HardwareControlProject)' == '' and Exists('$(MSBuildThisFileDirectory)dependencies/BooBoopControl/BooBoopControl.csproj')">$(MSBuildThisFileDirectory)dependencies/BooBoopControl/BooBoopControl.csproj</HardwareControlProject>
    <HardwareControlProject Condition="'$(HardwareControlProject)' == ''">$(MSBuildThisFileDirectory)../BooBoopControl/BooBoopControl.csproj</HardwareControlProject>
  </PropertyGroup>
  <ItemGroup><Compile Include="src/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(GameSignalsProject)" />
    <ProjectReference Include="$(HardwareControlProject)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(CoreDir)/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(CoreDir)/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(CoreDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(CoreDir)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckInstalledReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set GameDir to this game's existing BepInEx installation directory." />
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" Text="Missing installed reference: %(Reference.HintPath). Use the original BepInEx 6 IL2CPP core/interop; never replace with Mono or upgrade the loader." />
  </Target>
</Project>
